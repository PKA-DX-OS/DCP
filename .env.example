# Cổng truy cập công khai duy nhất qua APISIX
PUBLIC_BASE_URL=http://localhost:8080
GATEWAY_INTERNAL_URL=http://apisix:8080
SOURCE_URL=https://github.com/dxos-core/dxos

# Docker Compose Profiles (core, ai, ops, sim, tools)
COMPOSE_PROFILES=core

# Cấu hình chế độ demo (S-04: mặc định false trong môi trường sản xuất)
DEMO_MODE=false
DEMO_MFA=false
DEMO_TIME_SCALE=1
BREAK_GLASS_TTL=PT2H

# Cơ sở dữ liệu PostgreSQL 16 + pgvector
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=dxos

# 1. Superuser PostgreSQL (chỉ cấp cho container postgres)
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=dxos_dev_superuser_password_2026

# 2. Keycloak Database User
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=dxos_dev_keycloak_db_password_2026

# 3. Flowable Database User
FLOWABLE_DB_USER=flowable
FLOWABLE_DB_PASSWORD=dxos_dev_flowable_db_password_2026

# 4. DX-OS Services Database User
DB_USER=dxos_svc
DB_PASSWORD=dxos_dev_svc_password_2026

AUTHENTICATOR_PASSWORD=dxos_dev_authenticator_password_2026
DXOS_OWNER_PASSWORD=dxos_dev_owner_password_2026

# PostgREST 12.x
PGRST_DB_SCHEMAS=app_cap_phep,core_api
PGRST_DB_ANON_ROLE=anon
PGRST_ADMIN_SERVER_PORT=3001

# Keycloak 26.x
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=dxos_dev_keycloak_admin_2026
KEYCLOAK_URL=http://localhost:8080/auth
KEYCLOAK_INTERNAL_URL=http://keycloak:8080/auth
KEYCLOAK_REALM=dxos

# Flowable BPMN Engine 7.x
FLOWABLE_URL=http://flowable:8080/flowable-rest
FLOWABLE_USER=rest-admin
FLOWABLE_PASSWORD=dxos_dev_flowable_password_2026
FLOW_INTERNAL_TOKEN=dxos_dev_flow_internal_token_secret_2026

# NATS JetStream & MQTT
NATS_URL=nats://nats:4222
NATS_MQTT_PORT=8883
NATS_INGEST_USER=dxos_ingest
NATS_INGEST_PASSWORD=dxos_dev_nats_ingest_password_2026
NATS_MQTT_USER=sensor_phuong_a
NATS_MQTT_PASSWORD=dxos_dev_nats_mqtt_password_2026
NATS_SENSOR_B_USER=sensor_phuong_b
NATS_SENSOR_B_PASSWORD=dxos_dev_nats_sensor_b_password_2026

# SeaweedFS S3
SEAWEEDFS_S3_ENDPOINT=http://seaweedfs:8333
SEAWEEDFS_ACCESS_KEY=dxos_dev_s3_key_2026
SEAWEEDFS_SECRET_KEY=dxos_dev_s3_secret_2026
SEAWEEDFS_BACKUP_ACCESS_KEY=dxos_dev_s3_backup_key_2026
SEAWEEDFS_BACKUP_SECRET_KEY=dxos_dev_s3_backup_secret_2026

# ClamAV 1.4
CLAMAV_HOST=clamav
CLAMAV_PORT=3310

# OpenBao 2.2 KMS
OPENBAO_ADDR=http://openbao:8200
OPENBAO_TOKEN=dxos_dev_openbao_root_token_2026

# Ký số: pkcs11 (SoftHSM/PAdES, khuyến nghị demo) hoặc openbao (Transit legacy)
SIGNING_MODE=pkcs11
SOFTHSM_LIB=/usr/lib/softhsm/libsofthsm2.so
SOFTHSM_TOKEN=dxos
SOFTHSM_PIN=1234
SOFTHSM_CERT_LABEL=doc-sign
SOFTHSM_KEY_LABEL=doc-sign
TEST_CA_CERT=/certs/ca.crt

# APISIX Gateway & OIDC Clients Secrets
APISIX_OIDC_SECRET=dxos_dev_apisix_oidc_secret_2026
DX_SEED_SECRET=dxos_dev_seed_secret_2026
SVC_FILES_SECRET=dxos_dev_svc_files_secret_2026
SVC_DOC_SIGN_SECRET=dxos_dev_svc_doc_sign_secret_2026
SVC_FLOW_SECRET=dxos_dev_svc_flow_secret_2026
SVC_INGEST_SECRET=dxos_dev_svc_ingest_secret_2026
SVC_EXPORT_SECRET=dxos_dev_svc_export_secret_2026
SVC_AUDIT_SECRET=dxos_dev_svc_audit_secret_2026
SVC_ASSISTANT_SECRET=dxos_dev_svc_assistant_secret_2026
SENSOR_PHUONG_A_SECRET=dxos_dev_sensor_phuong_a_secret_2026
SENSOR_PHUONG_B_SECRET=dxos_dev_sensor_phuong_b_secret_2026

# Ollama (Profile ai)
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:0.5b
OLLAMA_EMBED_MODEL=bge-m3
