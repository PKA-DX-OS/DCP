[Unit]
Description=DX-OS GitOps Reconciler Service
After=network.target docker.service

[Service]
Type=oneshot
User=dxos
WorkingDirectory=/opt/dxos
ExecStart=/usr/bin/python3 ops/reconciler/reconciler.py
StandardOutput=journal
StandardError=journal
