{
  "id": "dxos",
  "realm": "dxos",
  "displayName": "DX-OS Open-Core SSO",
  "loginTheme": "dxos",
  "internationalizationEnabled": true,
  "supportedLocales": ["vi"],
  "defaultLocale": "vi",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "roles": {
    "realm": [
      {
        "name": "dx:platform-admin",
        "description": "Quản trị viên toàn bộ nền tảng hệ thống DX-OS"
      },
      {
        "name": "dx:tenant-admin",
        "description": "Quản trị viên cấp phường/thuê ước"
      },
      {
        "name": "dx:auditor",
        "description": "Kiểm toán viên độc lập xác minh chuỗi kiểm toán"
      },
      {
        "name": "dx:service",
        "description": "Tài khoản dịch vụ nội bộ hệ thống"
      },
      {
        "name": "dx:data-steward",
        "description": "Chủ quản dữ liệu (Data Steward)"
      }
    ]
  },
  "defaultDefaultClientScopes": [
    "role_list",
    "profile",
    "email",
    "web-origins"
  ],
  "clientScopes": [
    {
      "name": "dxos-claims",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "true"
      },
      "protocolMappers": [
        {
          "name": "tenant-mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "userinfo.token.claim": "true",
            "user.attribute": "tenant",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "tenant",
            "jsonType.label": "String"
          }
        },
        {
          "name": "postgrest-role-mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "role",
            "claim.value": "web_user",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true"
          }
        },
        {
          "name": "realm-roles-flat",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "multivalued": "true",
            "userinfo.token.claim": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "roles",
            "jsonType.label": "String"
          }
        },
        {
          "name": "sub-id-mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "id",
            "claim.name": "sub",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "username-mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "username",
            "claim.name": "preferred_username",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ],
  "clients": [
    {
      "clientId": "dxos-web",
      "name": "DX-OS Web Applications",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:8080/*",
        "http://127.0.0.1:8080/*"
      ],
      "webOrigins": [
        "http://localhost:8080",
        "http://127.0.0.1:8080",
        "+"
      ],
      "defaultClientScopes": [
        "web-origins",
        "profile",
        "roles",
        "email",
        "dxos-claims"
      ]
    },
    {
      "clientId": "apisix",
      "name": "APISIX Gateway Client",
      "enabled": true,
      "publicClient": false,
      "secret": "${APISIX_OIDC_SECRET}",
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false
    },
    {
      "clientId": "dx-test",
      "name": "E2E Testing Client",
      "enabled": true,
      "publicClient": true,
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": false,
      "defaultClientScopes": [
        "profile",
        "roles",
        "email",
        "dxos-claims"
      ]
    },
    {
      "clientId": "dx-seed",
      "name": "Seed Automation Client",
      "enabled": true,
      "publicClient": false,
      "secret": "${DX_SEED_SECRET}",
      "serviceAccountsEnabled": true,
      "directAccessGrantsEnabled": false
    },
    {
      "clientId": "svc-files",
      "name": "Files Service Account",
      "enabled": true,
      "serviceAccountsEnabled": true,
      "publicClient": false,
      "secret": "${SVC_FILES_SECRET}"
    },
    {
      "clientId": "svc-doc-sign",
      "name": "Doc Sign Service Account",
      "enabled": true,
      "serviceAccountsEnabled": true,
      "publicClient": false,
      "secret": "${SVC_DOC_SIGN_SECRET}"
    },
    {
      "clientId": "svc-flow",
      "name": "Flow Service Account",
      "enabled": true,
      "serviceAccountsEnabled": true,
      "publicClient": false,
      "secret": "${SVC_FLOW_SECRET}"
    },
    {
      "clientId": "svc-ingest",
      "name": "Ingest Service Account",
      "enabled": true,
      "serviceAccountsEnabled": true,
      "publicClient": false,
      "secret": "${SVC_INGEST_SECRET}"
    },
    {
      "clientId": "svc-export",
      "name": "Export Warm Service Account",
      "enabled": true,
      "serviceAccountsEnabled": true,
      "publicClient": false,
      "secret": "${SVC_EXPORT_SECRET}"
    },
    {
      "clientId": "svc-audit",
      "name": "Audit Service Account",
      "enabled": true,
      "serviceAccountsEnabled": true,
      "publicClient": false,
      "secret": "${SVC_AUDIT_SECRET}"
    },
    {
      "clientId": "svc-assistant",
      "name": "Assistant Service Account",
      "enabled": true,
      "serviceAccountsEnabled": true,
      "publicClient": false,
      "secret": "${SVC_ASSISTANT_SECRET}"
    },
    {
      "clientId": "dxos-sensor-phuong-a",
      "name": "Sensor Client Phuong A",
      "enabled": true,
      "serviceAccountsEnabled": true,
      "publicClient": false,
      "secret": "${SENSOR_PHUONG_A_SECRET}",
      "protocolMappers": [
        {
          "name": "tenant-mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "tenant",
            "claim.value": "phuong-a",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "roles-mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "roles",
            "claim.value": "[\"dx:device\"]",
            "jsonType.label": "JSON",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "dxos-sensor-phuong-b",
      "name": "Sensor Client Phuong B",
      "enabled": true,
      "serviceAccountsEnabled": true,
      "publicClient": false,
      "secret": "${SENSOR_PHUONG_B_SECRET}",
      "protocolMappers": [
        {
          "name": "tenant-mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "tenant",
            "claim.value": "phuong-b",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "roles-mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "roles",
            "claim.value": "[\"dx:device\"]",
            "jsonType.label": "JSON",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ]
}
